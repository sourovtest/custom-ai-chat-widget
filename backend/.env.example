# Display name used by AI prompts and generic responses.
BRAND_NAME=Support

# Comma-separated exact browser origins allowed to call the API. Never use "*".
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# MySQL server hostname or IP address.
MYSQL_HOST=127.0.0.1
# MySQL server TCP port.
MYSQL_PORT=3306
# MySQL application user. Use a least-privilege account, not root.
MYSQL_USER=
# Password for MYSQL_USER. Keep this value private.
MYSQL_PASSWORD=
# Name of the MySQL database created from database/schema.sql.
MYSQL_DATABASE=

# AI provider: fallback, gemini, or openai.
AI_PROVIDER=fallback
# API key for the selected AI_PROVIDER. Keep this value private.
AI_API_KEY=
# Optional model name supported by the selected provider.
AI_MODEL=
# Maximum time in seconds to wait for an AI response (1-60).
AI_TIMEOUT_SECONDS=10
# Additional provider request retries (0-3).
AI_MAX_RETRIES=1

# Optional legacy provider-specific keys. Prefer AI_API_KEY for new installs.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Administrator secret for protected rule-management endpoints.
ADMIN_API_KEY=
